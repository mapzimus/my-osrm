# Map data: raw OSM extracts + built OSRM artifacts (~100 GB). Never commit.
data/*
!data/.gitkeep

# Local tooling
.remember/
.env
logs/

# Experiment caches (re-computable in seconds)
experiments/*/cache/

# Playwright MCP output
.playwright-mcp/

# app: vendored libs are fetched by app/setup (MANIFEST.json is the record)
app/web/vendor/*
!app/web/vendor/MANIFEST.json
__pycache__/
*.pyc

# Overnight run log (experiments/isochrone/out/OVERNIGHT.md is the summary)
experiments/isochrone/out/*.log

# Optimal Drives renders (re-made by video.py; post from out/, never commit)
experiments/college_tour/out/
experiments/walmart/lkh/*.tgz
